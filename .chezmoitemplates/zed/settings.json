{
  "auto_install_extensions": {
    "harper": true,
    "material-icon-theme": true,
  },
  "base_keymap": "VSCode",
  "buffer_font_family": "Monaspace Argon NF",
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
    "ss10": true,
  },
  "buffer_font_size": 18,
  "cli_default_open_behavior": "new_window",
  "code_lens": "on",
  "collaboration_panel": {
    "button": false,
  },
  "colorize_brackets": true,
  "debugger": {
    "dock": "left",
  },
  "disable_ai": true,
  "format_on_save": "on",
  "git_panel": {
    "button": false,
  },
  "icon_theme": "Material Icon Theme",
  "inlay_hints": {
    "enabled": true,
    "show_other_hints": true,
    "show_parameter_hints": true,
    "show_type_hints": true,
  },
  "preferred_line_length": 120,
  "project_panel": {
    "dock": "right",
  },
  "restore_on_startup": "launchpad",
  "show_whitespaces": "trailing",
  "soft_wrap": "editor_width",
  "tabs": {
    "file_icons": true,
    "git_status": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "terminal": {
    "dock": "bottom",
    "font_features": {
      "calt": true,
      "liga": true,
    },
    "shell": "system",
  },
  "theme": {
    "dark": "Ayu Dark",
    "light": "One Light",
    "mode": "dark",
  },
  "ui_font_size": 16,
  "vim": {
    "highlight_on_yank_duration": 300,
    "toggle_relative_line_numbers": true,
    "use_smartcase_find": true,
  },
  "vim_mode": true,
}
